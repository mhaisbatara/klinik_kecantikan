APP_NAME="Klinik Kecantikan Mobile API"
APP_ENV=development
APP_DEBUG=true
APP_TZ="Asia/Jakarta"
APP_PORT=8008
APP_SERVER="http://127.0.0.1:8008"

# Database Configuration (Sama dengan backend web Laragon)
DB_DBMS=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=db_klinik_kecantikan

# Secret Keys untuk JWT & Hashing (Sesuai dengan express_standart_be)
USER_KEY=random
USER_PAS_KEY=random
USER_SECRET=random

# CORS: Izinkan semua origin (Mobile Android, iOS, Web)
ORIGIN="*"
ASSETS_PATH="http://127.0.0.1:8008/uploads"

# AI Chatbot LLM API Keys (Dukungan Multi-Provider Gratis)
# 1. Google Gemini (Model: gemini-flash-latest / gemini-3.8-flash)
GEMINI_API_KEY=
# 2. Groq Cloud (Model: llama-3.3-70b-versatile): Dapatkan di https://console.groq.com
GROQ_API_KEY=

# WhatsApp Gateway API (Fonnte): Dapatkan token gratis di https://fonnte.com
# Jika kosong, sistem otomatis beralih ke Mode Simulasi Lokal (dev_otp_code)
FONNTE_TOKEN=

