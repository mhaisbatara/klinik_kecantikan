{
  "name": "klinik-kecantikan-root",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"WEB_BE,WEB_FE,MOB_BE\" -c \"blue,green,magenta\" \"npm run dev:be\" \"npm run dev:fe\" \"npm run dev:flutter_be\"",
    "dev:web": "concurrently -n \"WEB_BE,WEB_FE\" -c \"blue,green\" \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:be": "cd express_standart_be && npm run dev",
    "dev:fe": "cd next_standart_fe && npm run dev",
    "dev:flutter_be": "cd flutter_express_be && npm run dev",
    "dev:flutter_fe": "cd flutter_standart_fe && flutter run",
    "start": "node express_standart_be/server.js",
    "start:be": "cd express_standart_be && npm start",
    "start:fe": "cd next_standart_fe && npm run dev",
    "start:flutter_be": "cd flutter_express_be && npm run dev",
    "start:flutter_fe": "cd flutter_standart_fe && flutter run"
  },
  "dependencies": {
    "lucide-react": "^1.43.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
